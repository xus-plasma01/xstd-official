#ifndef _xstdio
#define _xstdio

#include "xstdarg"
#include "xstdsys"

namespace xus
{

/// xus::__outf(fmt, ...)
void __outf(const char *fmt, ...)
{
	va_list xargs;
	va_start(xargs, fmt);

	while (*fmt)
	{
		if (*fmt == '%')
		{
			fmt++;
			switch(*fmt)
			{
			case '\0':
				{
					xus::putchar('%');
					goto end;
				}
			case '%':
				{
					xus::putchar('%');
					break;
				}
			case 's':
				{
					const char *s = va_arg(xargs, const char *);
					while (*s)
					{
						xus::putchar(*s);
						s++;
					}
					break;
				}
			case 'd':
				{
					int value = va_arg(xargs, int);
					unsigned magnitude = value;
					if (value < 0)
					{
						xus::putchar('-');
						magnitude = -value;
					}

					unsigned div = 1;
					while (magnitude / div > 9)
						div *= 10;

					while (div > 0)
					{
						xus::putchar('0' + magnitude / div);
						magnitude %= div;
						div /= 10;
					}
					break;
				}
			case 'x':
				{
					unsigned value = va_arg(xargs, unsigned);
					for (int i = 7; i >= 0; i--)
					{
						unsigned n = (value >> (i * 4)) & 0xf;
						xus::putchar("0123456789abcdef"[n]);
					}

					break;
				}
			}
		}
		else
		{
			xus::putchar(*fmt);
		}
		fmt++;
	}
	end:	va_end(xargs);
}

/// xus::outf(fmt, ...);
void outf(const char *fmt, ...)
{
	va_list xargs;
	__outf(fmt, xargs);
}

}

#endif
